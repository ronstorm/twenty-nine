## 🎨 SwiftUI Best Practices

### View Composition

```swift
// ✅ Good: Small, focused views
struct CountryRow: View {
    let country: Country
    
    var body: some View {
        HStack {
            Text(country.emoji)
                .font(.largeTitle)
            
            VStack(alignment: .leading) {
                Text(country.name)
                    .font(.headline)
                Text(country.continent)
                    .font(.subheadline)
                    .foregroundStyle(.secondary)
            }
        }
    }
}

// ✅ Good: Extract complex views
struct CountryDetailView: View {
    let country: Country
    
    var body: some View {
        ScrollView {
            headerSection
            informationSection
            funFactSection
        }
    }
    
    private var headerSection: some View {
        VStack {
            Text(country.emoji)
                .font(.system(size: 100))
            Text(country.name)
                .font(.largeTitle)
        }
    }
    
    private var informationSection: some View {
        // ...
    }
}

// ❌ Bad: Massive views with all logic inline
struct BadView: View {
    var body: some View {
        // 200+ lines of nested views
    }
}
```

### State Management

```swift
// ✅ Good: Use @State for view-local state
struct CountrySearchView: View {
    @State private var searchText = ""
    @State private var isShowingFilters = false
    
    var body: some View {
        // ...
    }
}

// ✅ Good: Use @Observable for ViewModels (iOS 17+)
@Observable
final class CountryListViewModel {
    var countries: [Country] = []
    var isLoading = false
}

// ✅ Good: Inject dependencies
struct CountryListView: View {
    @State private var viewModel: CountryListViewModel
    
    init(countryService: CountryServiceProtocol) {
        _viewModel = State(
            wrappedValue: CountryListViewModel(countryService: countryService)
        )
    }
}
```

