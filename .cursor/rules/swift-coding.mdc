## 🧪 Testing Best Practices

### Test Structure

```swift
// ✅ Good: Clear test structure with Given-When-Then
final class CountryServiceTests: XCTestCase {
    var sut: CountryService!
    var mockClient: MockApolloClient!
    
    override func setUp() {
        super.setUp()
        mockClient = MockApolloClient()
        sut = CountryService(apolloClient: mockClient)
    }
    
    override func tearDown() {
        sut = nil
        mockClient = nil
        super.tearDown()
    }
    
    func testFetchCountries_WhenSuccessful_ReturnsCountries() async throws {
        // Given
        mockClient.mockResponse = validCountriesResponse
        
        // When
        let countries = try await sut.fetchCountries()
        
        // Then
        XCTAssertEqual(countries.count, 3)
        XCTAssertEqual(countries.first?.name, "United States")
    }
    
    func testFetchCountries_WhenNetworkFails_ThrowsError() async {
        // Given
        mockClient.shouldFail = true
        
        // When/Then
        await XCTAssertThrowsError(try await sut.fetchCountries())
    }
}
```

