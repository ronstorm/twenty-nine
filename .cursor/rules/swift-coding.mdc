## 🏗️ Code Organization

### File Structure

```swift
//  Country.swift
//  CountryFacts
//
//  Created by Amit Sen on November 1, 2025.
//  © 2025 Coding With Amit. All rights reserved.

import Foundation

// MARK: - Main Type

/// Represents a country with basic information.
struct Country: Identifiable, Codable, Sendable {
    let id: String
    let name: String
    let code: String
    let emoji: String
}

// MARK: - Extensions

extension Country {
    var displayName: String {
        "\(emoji) \(name)"
    }
}

// MARK: - Helpers

extension Country: Comparable {
    static func < (lhs: Country, rhs: Country) -> Bool {
        lhs.name < rhs.name
    }
}
```

### Use MARK Comments

```swift
// ✅ Good: Organize code with MARK
class CountryService {
    
    // MARK: - Properties
    
    private let apolloClient: ApolloClient
    private let cache: CountryCache
    
    // MARK: - Initialization
    
    init(apolloClient: ApolloClient, cache: CountryCache) {
        self.apolloClient = apolloClient
        self.cache = cache
    }
    
    // MARK: - Public API
    
    func fetchCountries() async throws -> [Country] {
        // ...
    }
    
    // MARK: - Private Helpers
    
    private func transformData(_ data: Data) throws -> [Country] {
        // ...
    }
}
```

