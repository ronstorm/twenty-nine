## ⚡ Performance Considerations

### Lazy Evaluation

```swift
// ✅ Good: Use lazy for large transformations
let processedCountries = countries.lazy
    .filter { $0.population > 1_000_000 }
    .map { $0.name.uppercased() }
    .prefix(10)

// ✅ Good: Lazy properties for expensive computations
struct CountryDetails {
    let rawData: Data
    
    lazy var parsedContent: [String: Any] = {
        // Expensive parsing only when needed
        try? JSONSerialization.jsonObject(with: rawData) as? [String: Any] ?? [:]
    }()
}
```

### Collection Operations

```swift
// ✅ Good: Use appropriate collection methods
let firstLargeCountry = countries.first { $0.population > 100_000_000 }
let hasEuropean = countries.contains { $0.continent == "Europe" }

// ✅ Good: Use compactMap to filter and transform
let countryNames: [String] = optionalCountries.compactMap { $0?.name }

// ❌ Bad: Unnecessary intermediate arrays
let names = countries.filter { $0.population > 1000 }.map { $0.name } // Better to use one pass
```

### Memory Management

```swift
// ✅ Good: Use [weak self] in closures to avoid retain cycles
class CountryService {
    func setupObserver() {
        NotificationCenter.default.addObserver(
            forName: .countryUpdated,
            object: nil,
            queue: .main
        ) { [weak self] notification in
            self?.handleUpdate(notification)
        }
    }
}

// ✅ Good: Use [unowned self] when self is guaranteed to exist
class CountryViewModel {
    private let service: CountryService
    
    init(service: CountryService) {
        self.service = service
        
        // self will always exist as long as closure exists
        service.onUpdate = { [unowned self] in
            self.refresh()
        }
    }
}

// ✅ Good: Deinit for cleanup
class CountryObserver {
    deinit {
        NotificationCenter.default.removeObserver(self)
    }
}
```

