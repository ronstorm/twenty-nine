## 🛡️ Error Handling

### Structured Error Types

```swift
// ✅ Good: Use custom error types
enum CountryServiceError: Error {
    case networkError(underlying: Error)
    case invalidResponse(statusCode: Int)
    case decodingFailed
    case countryNotFound(code: String)
}

// ✅ Good: Adopt LocalizedError for user-facing errors
extension CountryServiceError: LocalizedError {
    var errorDescription: String? {
        switch self {
        case .networkError:
            return "Unable to connect to the server"
        case .invalidResponse(let code):
            return "Server returned error code \(code)"
        case .decodingFailed:
            return "Failed to process server response"
        case .countryNotFound(let code):
            return "Country with code '\(code)' not found"
        }
    }
}
```

### Error Propagation

```swift
// ✅ Good: Let errors propagate when appropriate
func fetchCountry(code: String) async throws -> Country {
    let data = try await networkService.fetch(endpoint: "/country/\(code)")
    return try JSONDecoder().decode(Country.self, from: data)
}

// ✅ Good: Handle specific errors when needed
func loadCountries() async {
    do {
        countries = try await countryService.fetchCountries()
        errorMessage = nil
    } catch let error as CountryServiceError {
        errorMessage = error.localizedDescription
        logger.error("Service error: \(error)")
    } catch {
        errorMessage = "An unexpected error occurred"
        logger.error("Unexpected error: \(error)")
    }
}

// ✅ Good: Use Result type for completion-based APIs
func fetchCountries(completion: @escaping (Result<[Country], Error>) -> Void) {
    // Only use when async/await isn't available
}

// ❌ Bad: Swallowing errors silently
func badLoad() async {
    try? await fetchCountries() // Error information lost!
}
```

