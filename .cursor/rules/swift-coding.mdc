## 📦 Type Safety & Optionals

### Optional Handling

```swift
// ✅ Good: Use optional binding
if let country = optionalCountry {
    print(country.name)
}

// ✅ Good: Guard for early returns
guard let country = optionalCountry else {
    return
}

// ✅ Good: Nil coalescing
let countryName = country?.name ?? "Unknown"

// ✅ Good: Optional chaining
let capitalCity = country?.capital?.name

// ✅ Good: Combine with if-let shorthand (Swift 5.7+)
if let country {
    print(country.name)
}

// ❌ Bad: Force unwrapping (avoid unless absolutely certain)
let name = country!.name // Dangerous!

// ❌ Bad: Implicitly unwrapped optionals (use sparingly)
var country: Country! // Only for specific cases like IBOutlets
```

### Type Inference vs. Explicit Types

```swift
// ✅ Good: Use type inference for simple cases
let name = "Switzerland"
let count = 42
let countries = ["US", "UK", "CA"]

// ✅ Good: Be explicit when clarity helps
let latitude: Double = 47.5
let settings: [String: Any] = ["theme": "dark"]

// ✅ Good: Explicit for empty collections
let countries: [Country] = []
let countryMap: [String: Country] = [:]

// ❌ Bad: Unnecessary explicit types
let name: String = "Switzerland" // Type obvious from literal
```

