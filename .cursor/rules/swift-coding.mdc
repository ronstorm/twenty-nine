# Swift 6.2 Coding Best Practices

## 🎯 Core Principles

### 1. Write Safe, Concurrent Code
Swift 6 introduces **complete data race safety** at compile time. Embrace the concurrency model.

### 2. Prefer Value Types Over Reference Types
Use `struct` and `enum` by default; use `class` only when needed (inheritance, identity).

### 3. Be Explicit and Clear
Favor clarity over brevity. Code is read more often than written.

### 4. Leverage Type Safety
Use Swift's powerful type system to catch errors at compile time.

---

## 🔒 Swift 6 Concurrency & Data Isolation

### Sendable and Data Race Safety

```swift
// ✅ Good: Value types are implicitly Sendable
struct Country: Sendable {
    let name: String
    let code: String
}

// ✅ Good: Actors for mutable shared state
actor CountryCache {
    private var cache: [String: Country] = [:]
    
    func get(_ code: String) -> Country? {
        cache[code]
    }
    
    func set(_ country: Country, for code: String) {
        cache[code] = country
    }
}

// ✅ Good: @MainActor for UI updates
@MainActor
final class CountryViewModel: ObservableObject {
    @Published var countries: [Country] = []
    
    func updateCountries(_ newCountries: [Country]) {
        // Guaranteed to run on main thread
        self.countries = newCountries
    }
}

// ❌ Bad: Mutable class without isolation
class UnsafeCache {
    var cache: [String: Country] = [:] // Data race possible!
}
```

### Async/Await Best Practices

```swift
// ✅ Good: Use async/await consistently
func fetchCountries() async throws -> [Country] {
    let (data, _) = try await URLSession.shared.data(from: url)
    return try JSONDecoder().decode([Country].self, from: data)
}

// ✅ Good: Structured concurrency with async let
func fetchCountryDetails(code: String) async throws -> CountryDetails {
    async let basicInfo = fetchBasicInfo(code)
    async let population = fetchPopulation(code)
    async let languages = fetchLanguages(code)
    
    return try await CountryDetails(
        info: basicInfo,
        population: population,
        languages: languages
    )
}

// ✅ Good: Task groups for dynamic concurrency
func fetchMultipleCountries(codes: [String]) async throws -> [Country] {
    try await withThrowingTaskGroup(of: Country.self) { group in
        for code in codes {
            group.addTask { try await self.fetchCountry(code) }
        }
        
        var countries: [Country] = []
        for try await country in group {
            countries.append(country)
        }
        return countries
    }
}

// ❌ Bad: Mixing completion handlers with async/await
func badFetch(completion: @escaping (Result<[Country], Error>) -> Void) {
    Task {
        // Don't mix patterns!
    }
}
```

### MainActor Usage

```swift
// ✅ Good: Mark entire class with @MainActor
@MainActor
final class CountryListViewModel: ObservableObject {
    @Published var countries: [Country] = []
    @Published var isLoading = false
    
    func loadCountries() async {
        // All methods implicitly @MainActor
        isLoading = true
        defer { isLoading = false }
        // ...
    }
}

// ✅ Good: Mark only UI-updating methods
final class DataProcessor {
    func processData() async -> [Country] {
        // Background work
        return processedCountries
    }
    
    @MainActor
    func updateUI(with countries: [Country]) {
        // UI updates on main thread
    }
}

// ✅ Good: Non-isolated async functions
nonisolated func performBackgroundWork() async -> Data {
    // Explicitly non-isolated from actor context
    return processedData
}
```

### Actor Patterns

```swift
// ✅ Good: Actor for shared mutable state
actor NetworkManager {
    private var activeRequests: Set<String> = []
    
    func startRequest(_ id: String) -> Bool {
        guard !activeRequests.contains(id) else { return false }
        activeRequests.insert(id)
        return true
    }
    
    func endRequest(_ id: String) {
        activeRequests.remove(id)
    }
}

// ✅ Good: Global actor for domain-specific isolation
@globalActor
actor DatabaseActor {
    static let shared = DatabaseActor()
}

@DatabaseActor
func saveToDB(_ data: Data) {
    // All database operations isolated
}
```

